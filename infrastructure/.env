# Local development values. Replace the password before running this anywhere shared.
POSTGRES_DB=fermentlab
POSTGRES_USER=fermentlab
POSTGRES_PASSWORD=fermentlab
POSTGRES_PORT=5432

APP_REST_PORT=8080
SCHEDULER_PORT=8081
FRONTEND_PORT=4200

# Origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost

# Every 30 minutes.
SCHEDULER_CRON=0 */30 * * * *
